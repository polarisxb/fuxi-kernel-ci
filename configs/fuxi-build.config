# Keep the stock defconfig, KMI and signing policy; add builtin SukiSU/SUSFS only.
BUILD_GKI_ARTIFACTS=
BUILD_GKI_CERTIFICATION_TOOLS=
POST_DEFCONFIG_CMDS="${POST_DEFCONFIG_CMDS}; python3 ${TASK_ROOT}/scripts/check-config.py \${OUT_DIR}/.config ${TASK_ROOT}/configs/stock.config sukisu --pretrim"
POST_KERNEL_BUILD_CMDS="python3 ${TASK_ROOT}/scripts/check-config.py \${OUT_DIR}/.config ${TASK_ROOT}/configs/stock.config sukisu"
seed_signing_key() {
  mkdir -p "$OUT_DIR/certs"
  install -m 0600 "$SIGNING_KEY_DIR/signing_key.pem" "$OUT_DIR/certs/signing_key.pem"
  install -m 0644 "$SIGNING_KEY_DIR/signing_key.x509" "$OUT_DIR/certs/signing_key.x509"
}
PRE_DEFCONFIG_CMDS=seed_signing_key

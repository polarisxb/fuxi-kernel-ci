Subject: susfs: report an enabled-features allocation failure safely
Upstream-Status: Pending [simonpunk/susfs4ksu gki-android13-5.15]
Drop-when: upstream stops writing through the failed allocation

susfs_get_enabled_features() stored -ENOMEM through the NULL pointer
it had just failed to allocate. Copy the error code to the user
buffer instead.
---
diff --git a/fs/susfs.c b/fs/susfs.c
index cb6a70afc806b850acbf179d1d5e0c21fceb031d..03b5a56a2a6d28309bb56a4f5b1fe21373d56584 100644
--- a/fs/susfs.c
+++ b/fs/susfs.c
@@ -1188,8 +1188,13 @@ void susfs_get_enabled_features(void __user **user_info) {
 	size_t copied_size = 0;
 
 	if (!info) {
-		info->err = -ENOMEM;
-		goto out_copy_to_user;
+		int err = -ENOMEM;
+
+		if (copy_to_user(&((struct st_susfs_enabled_features __user *)*user_info)->err,
+				 &err, sizeof(err)))
+			err = -EFAULT;
+		SUSFS_LOGI("CMD_SUSFS_SHOW_ENABLED_FEATURES -> ret: %d\n", err);
+		return;
 	}
 
 	if (copy_from_user(info, (struct st_susfs_enabled_features __user*)*user_info, sizeof(struct st_susfs_enabled_features))) {

Subject: kernel_umount: add the missing feature set handler
Upstream-Status: Pending [SukiSU-Ultra builtin]
Drop-when: upstream builtin defines kernel_umount_feature_set()

kernel_umount_handler refers to kernel_umount_feature_set(), which
e2912817 never defines, so the driver does not compile.
---
diff --git a/kernel/feature/kernel_umount.c b/kernel/feature/kernel_umount.c
index ac7184f6c359f2e267d8f0b576a9e9b6452ed2cf..ef9d8abdfc69e20fedf9f08a499bdf01a7277e8b 100644
--- a/kernel/feature/kernel_umount.c
+++ b/kernel/feature/kernel_umount.c
@@ -6,6 +6,14 @@ static int kernel_umount_feature_get(u64 *value)
     return 0;
 }
 
+static int kernel_umount_feature_set(u64 value)
+{
+    bool enable = value != 0;
+    ksu_kernel_umount_enabled = enable;
+    pr_info("kernel_umount: set to %d\n", enable);
+    return 0;
+}
+
 static const struct ksu_feature_handler kernel_umount_handler = {
     .feature_id = KSU_FEATURE_KERNEL_UMOUNT,
     .name = "kernel_umount",

Subject: sucompat: match the SUSFS hook contract
Upstream-Status: Pending [SukiSU-Ultra builtin]
Drop-when: upstream shares one declaration of these hooks with the SUSFS patch

Include include/linux/sukisu_hooks.h so these definitions are checked
against the declarations the SUSFS hooks use, access
ksu_su_compat_enabled with READ_ONCE()/WRITE_ONCE() because the hooks
read it without locking, and reject a NULL filename before comparing
it.
---
diff --git a/kernel/feature/sucompat.c b/kernel/feature/sucompat.c
index 54a1a704696b247ca1e5b630ca1ea036d8bb705c..3a7a78ace105973857b07a32e86c471bdb0f2947 100644
--- a/kernel/feature/sucompat.c
+++ b/kernel/feature/sucompat.c
@@ -9,14 +9,14 @@ static const char ksud_path[] = KSUD_PATH;
 
 static int su_compat_feature_get(u64 *value)
 {
-    *value = ksu_su_compat_enabled ? 1 : 0;
+    *value = READ_ONCE(ksu_su_compat_enabled) ? 1 : 0;
     return 0;
 }
 
 static int su_compat_feature_set(u64 value)
 {
     bool enable = value != 0;
-    ksu_su_compat_enabled = enable;
+    WRITE_ONCE(ksu_su_compat_enabled, enable);
     pr_info("su_compat: set to %d\n", enable);
     return 0;
 }
@@ -177,39 +177,39 @@ int ksu_handle_execveat(int *fd, struct filename **filename_ptr, void *argv,
                         flags);
 }
 
-int ksu_handle_faccessat(int *dfd, struct filename **filename, int *mode,
-             int *__unused_flags)
+int ksu_handle_faccessat(int *dfd, struct filename **filename, int *mode, int *__unused_flags)
 {
-    if (unlikely(IS_ERR(*filename) || (*filename)->name == NULL))
+    if (unlikely(!filename || IS_ERR_OR_NULL(*filename) || !(*filename)->name))
         return 0;
 
-    if (likely(memcmp((*filename)->name, su_path, sizeof(su_path))))
+    if (likely(strcmp((*filename)->name, su_path)))
         return 0;
 
-    if (current_chrooted())
-    {
-        pr_err("ksu_handle_faccessat: su found but NOT allowed! Because current process is running in chrooted environment\n");
+    if (current_chrooted()) {
+        pr_err("ksu_handle_faccessat: su denied in chroot\n");
         return 0;
     }
+
     pr_info("ksu_handle_faccessat: su->sh!\n");
-    memcpy((void *)((*filename)->name), sh_path, sizeof(sh_path));
+    memcpy((void *)(*filename)->name, sh_path, sizeof(sh_path));
     return 0;
 }
 
-int ksu_handle_stat(int *dfd, struct filename **filename, int *flags) {
-    if (unlikely(IS_ERR(*filename) || (*filename)->name == NULL))
+int ksu_handle_stat(int *dfd, struct filename **filename, int *flags)
+{
+    if (unlikely(!filename || IS_ERR_OR_NULL(*filename) || !(*filename)->name))
         return 0;
 
-    if (likely(memcmp((*filename)->name, su_path, sizeof(su_path))))
+    if (likely(strcmp((*filename)->name, su_path)))
         return 0;
 
-    if (current_chrooted())
-    {
-        pr_err("ksu_handle_stat: su found but NOT allowed! Because current process is running in chrooted environment\n");
+    if (current_chrooted()) {
+        pr_err("ksu_handle_stat: su denied in chroot\n");
         return 0;
     }
+
     pr_info("ksu_handle_stat: su->sh!\n");
-    memcpy((void *)((*filename)->name), sh_path, sizeof(sh_path));
+    memcpy((void *)(*filename)->name, sh_path, sizeof(sh_path));
     return 0;
 }
 
diff --git a/kernel/feature/sucompat.h b/kernel/feature/sucompat.h
index 1846cdcafd9b1569c45cf36718ddbb8942437e40..07562644b844d6f746dfc6c4c0e87f2f1a416a88 100644
--- a/kernel/feature/sucompat.h
+++ b/kernel/feature/sucompat.h
@@ -6,6 +6,7 @@
 extern bool ksu_su_compat_enabled;
 
 #ifdef CONFIG_KSU_SUSFS
+#include <linux/sukisu_hooks.h>
 int ksu_handle_faccessat(int *dfd, struct filename **filename, int *mode,
              int *__unused_flags);
 int ksu_handle_stat(int *dfd, struct filename **filename, int *flags);
